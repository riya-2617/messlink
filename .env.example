# MessLink Environment Variable Configuration
# IMPORTANT: Never commit actual secret keys or credentials to source control.
# Copy this file to .env and populate with your environment-specific credentials.

# Application Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Kolkata

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=file:./dev.db
# For production PostgreSQL: postgresql://messlink_user:secure_password@localhost:5432/messlink_db?schema=public

# Session & JWT Secrets
JWT_SECRET=replace_with_a_cryptographically_secure_random_64_byte_hex_string
COOKIE_SECRET=replace_with_a_cryptographically_secure_random_64_byte_hex_string

# Razorpay Payment Gateway (SANDBOX CREDENTIALS ONLY IN DEV)
RAZORPAY_KEY_ID=rzp_test_YourSandboxKeyHere
RAZORPAY_KEY_SECRET=YourSandboxSecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretKeyHere
ENABLE_LIVE_PAYMENTS=false

# AI Vision & OCR Service
# Supported providers: Google Gemini Vision API / Tesseract OCR
VISION_API_KEY=your_gemini_api_key_for_multilingual_menu_ocr
OCR_PROVIDER=gemini_vision

# Indian SMS & OTP Service (DLT Registered in India)
SMS_GATEWAY_PROVIDER=mock_otp_service
SMS_DLT_SENDER_ID=MSSLNK
SMS_DLT_TEMPLATE_ID=110716123456789

# Storage Configuration for Menu Photos
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=5242880 # 5 MB

# Telemetry & Compliance
DPDPA_COMPLIANCE_MODE=strict
CERTIN_LOG_RETENTION_DAYS=180
LOG_LEVEL=info
